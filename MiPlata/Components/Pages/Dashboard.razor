@page "/dashboard"
@rendermode InteractiveServer
@using MiPlata.Models
@inject CajeroService cajeroService
@inject NavigationManager Navigation

<div class="min-h-screen">
    <NavbarComponent Variant="NavbarVariant.Dashboard" UserName="@userName" OnLogout="HandleLogout" />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Welcome Section -->
        <div class="mb-8">
            <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2">
                ¡Hola, @userName! 👋
            </h1>
            <p class="text-gray-600">Aquí está el resumen de tu cuenta</p>
        </div>

        <!-- Balance Card -->
        <div class="mb-8 p-6 md:p-8 bg-gradient-to-br from-purple-600 via-pink-600 to-blue-600 text-white border-0 shadow-xl rounded-xl">
            <div class="flex justify-between items-start mb-6">
                <div>
                    <p class="text-purple-100 mb-2">Saldo Disponible</p>
                    <div class="flex items-center gap-3">
                        @if (showBalance)
                        {
                            <h2 class="text-3xl md:text-4xl font-bold">
                                $@balance.ToString("N2") MXN
                            </h2>
                        }
                        else
                        {
                            <h2 class="text-3xl md:text-4xl font-bold">••••••</h2>
                        }
                        <button @onclick="() => showBalance = !showBalance"
                                class="p-2 hover:bg-white/20 rounded-lg transition-colors">
                            @(showBalance ? "👁️" : "👁️‍🗨️")
                        </button>
                    </div>
                </div>
                <div class="bg-white/20 backdrop-blur-sm p-3 rounded-2xl">
                    <span class="text-2xl">💳</span>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div class="bg-white/10 backdrop-blur-sm rounded-xl p-4">
                    <div class="flex items-center gap-2 mb-2">
                        <span class="text-green-300">⬇️</span>
                        <p class="text-sm text-purple-100">Ingresos</p>
                    </div>
                    <p class="text-xl font-bold">$@totalIncome.ToString("N2")</p>
                </div>
                <div class="bg-white/10 backdrop-blur-sm rounded-xl p-4">
                    <div class="flex items-center gap-2 mb-2">
                        <span class="text-red-300">⬆️</span>
                        <p class="text-sm text-purple-100">Gastos</p>
                    </div>
                    <p class="text-xl font-bold">$@totalExpenses.ToString("N2")</p>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
            <div @onclick="() => mostrarTransferDialog = true" class="p-4 cursor-pointer hover:shadow-lg transition-all hover:-translate-y-1 border-2 border-purple-100 bg-gradient-to-br from-white to-purple-50/30 rounded-xl">
                <div class="flex flex-col items-center text-center gap-2">
                    <div class="bg-gradient-to-br from-purple-500 to-pink-500 p-3 rounded-2xl">
                        <span class="text-white text-2xl">📤</span>
                    </div>
                    <span class="font-medium text-gray-900">Transferir</span>
                </div>
            </div>

            <div class="p-4 cursor-pointer hover:shadow-lg transition-all hover:-translate-y-1 border-2 border-purple-100 bg-gradient-to-br from-white to-blue-50/30 rounded-xl">
                <div class="flex flex-col items-center text-center gap-2">
                    <div class="bg-gradient-to-br from-blue-500 to-cyan-500 p-3 rounded-2xl">
                        <span class="text-white text-2xl">➕</span>
                    </div>
                    <span class="font-medium text-gray-900">Recargar</span>
                </div>
            </div>

            <div class="p-4 cursor-pointer hover:shadow-lg transition-all hover:-translate-y-1 border-2 border-purple-100 bg-gradient-to-br from-white to-pink-50/30 rounded-xl">
                <div class="flex flex-col items-center text-center gap-2">
                    <div class="bg-gradient-to-br from-pink-500 to-purple-500 p-3 rounded-2xl">
                        <span class="text-white text-2xl">💳</span>
                    </div>
                    <span class="font-medium text-gray-900">Tarjetas</span>
                </div>
            </div>

            <div class="p-4 cursor-pointer hover:shadow-lg transition-all hover:-translate-y-1 border-2 border-purple-100 bg-gradient-to-br from-white to-green-50/30 rounded-xl">
                <div class="flex flex-col items-center text-center gap-2">
                    <div class="bg-gradient-to-br from-green-500 to-emerald-500 p-3 rounded-2xl">
                        <span class="text-white text-2xl">🎁</span>
                    </div>
                    <span class="font-medium text-gray-900">Recompensas</span>
                </div>
            </div>
        </div>

        <!-- Transactions List -->
        <div class="p-6 border-2 border-purple-100 rounded-xl bg-white shadow-lg">
            <h3 class="text-xl font-bold mb-4 text-gray-900">Transacciones Recientes</h3>
            <div class="space-y-3">
                @foreach (var transaction in transactions)
                {
                    <div class="flex items-center justify-between p-3 hover:bg-purple-50 rounded-lg transition-colors">
                        <div class="flex items-center gap-3">
                            <div class="text-2xl">@transaction.Icon</div>
                            <div>
                                <p class="font-medium text-gray-900">@transaction.Description</p>
                                <div class="flex items-center gap-2 text-sm text-gray-500">
                                    <span>📅</span>
                                    <span>@transaction.Date.ToString("dd/MM/yyyy")</span>
                                    <span>•</span>
                                    <span>@transaction.Category</span>
                                </div>
                            </div>
                        </div>
                        <div class="@(transaction.Amount > 0 ? "text-green-600" : "text-red-600") font-bold">
                            @(transaction.Amount > 0 ? "+" : "")$@Math.Abs(transaction.Amount).ToString("N2")
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Transfer Dialog -->
@if (mostrarTransferDialog)
{
    <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4" @onclick="() => mostrarTransferDialog = false">
        <div class="bg-white rounded-2xl p-6 max-w-md w-full shadow-2xl" @onclick:stopPropagation="true">
            <div class="mb-6">
                <h2 class="text-2xl font-bold bg-gradient-to-r from-purple-600 to-pink-600 bg-clip-text text-transparent">
                    Nueva Transferencia
                </h2>
            </div>

            <div class="space-y-4">
                <div class="space-y-2">
                    <label class="text-gray-700 font-medium">Destinatario</label>
                    <input type="text"
                           placeholder="Nombre o correo"
                           @bind="transferRecipient"
                           class="w-full px-4 py-3 border-2 border-purple-200 focus:border-purple-400 rounded-lg outline-none transition-colors" />
                </div>

                <div class="space-y-2">
                    <label class="text-gray-700 font-medium">Cantidad (MXN)</label>
                    <div class="relative">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">💵</span>
                        <input type="number"
                               step="0.01"
                               placeholder="0.00"
                               @bind="transferAmount"
                               class="w-full pl-10 pr-4 py-3 border-2 border-purple-200 focus:border-purple-400 rounded-lg outline-none transition-colors" />
                    </div>
                </div>

                <div class="space-y-2">
                    <label class="text-gray-700 font-medium">Concepto</label>
                    <input type="text"
                           placeholder="¿Para qué es?"
                           @bind="transferConcept"
                           class="w-full px-4 py-3 border-2 border-purple-200 focus:border-purple-400 rounded-lg outline-none transition-colors" />
                </div>

                @if (!string.IsNullOrEmpty(transferMessage))
                {
                    <div class="@(transferMessage.Contains("exitosa") ? "bg-green-50 border-green-200 text-green-700" : "bg-red-50 border-red-200 text-red-700") border-2 rounded-lg p-4">
                        <p class="font-medium">@transferMessage</p>
                    </div>
                }

                <div class="flex gap-3">
                    <button @onclick="HandleTransfer"
                            class="flex-1 py-3 bg-gradient-to-r from-purple-500 to-pink-500 hover:from-purple-600 hover:to-pink-600 text-white rounded-lg font-medium transition-all">
                        Enviar Dinero
                    </button>
                    <button @onclick="() => mostrarTransferDialog = false"
                            class="px-6 py-3 border-2 border-gray-300 text-gray-700 hover:bg-gray-50 rounded-lg font-medium transition-all">
                        Cancelar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string userName = "Usuario";
    private decimal balance = 12450.50m;
    private bool showBalance = true;
    private decimal totalIncome = 7950.00m;
    private decimal totalExpenses = 2348.00m;

    private bool mostrarTransferDialog = false;
    private string transferRecipient = "";
    private decimal transferAmount = 0;
    private string transferConcept = "";
    private string transferMessage = "";

    private List<Transaction> transactions = new()
    {
        new Transaction { Icon = "💰", Description = "Depósito mensual", Amount = 5000, Date = DateTime.Now.AddDays(-5), Category = "Ingreso" },
        new Transaction { Icon = "🎬", Description = "Netflix", Amount = -199, Date = DateTime.Now.AddDays(-6), Category = "Suscripciones" },
        new Transaction { Icon = "👤", Description = "Transferencia a María", Amount = -500, Date = DateTime.Now.AddDays(-7), Category = "Transferencia" },
        new Transaction { Icon = "🍔", Description = "Uber Eats", Amount = -350, Date = DateTime.Now.AddDays(-8), Category = "Comida" },
        new Transaction { Icon = "💼", Description = "Freelance trabajo", Amount = 2500, Date = DateTime.Now.AddDays(-10), Category = "Ingreso" },
        new Transaction { Icon = "🎵", Description = "Spotify", Amount = -99, Date = DateTime.Now.AddDays(-11), Category = "Suscripciones" },
        new Transaction { Icon = "🛍️", Description = "Compras Amazon", Amount = -1200, Date = DateTime.Now.AddDays(-13), Category = "Compras" },
        new Transaction { Icon = "✅", Description = "Reembolso", Amount = 450, Date = DateTime.Now.AddDays(-15), Category = "Ingreso" }
    };

    private void HandleLogout()
    {
        Navigation.NavigateTo("/");
    }

    private void HandleTransfer()
    {
        transferMessage = "";

        if (string.IsNullOrWhiteSpace(transferRecipient) || transferAmount <= 0 || string.IsNullOrWhiteSpace(transferConcept))
        {
            transferMessage = "Por favor completa todos los campos";
            return;
        }

        if (transferAmount > balance)
        {
            transferMessage = "Saldo insuficiente";
            return;
        }

        balance -= transferAmount;
        totalExpenses += transferAmount;

        transferMessage = $"¡Transferencia exitosa! 🎉 ${transferAmount:N2} enviados a {transferRecipient}";

        // Agregar transacción a la lista
        transactions.Insert(0, new Transaction
        {
            Icon = "📤",
            Description = $"Transferencia a {transferRecipient}",
            Amount = -transferAmount,
            Date = DateTime.Now,
            Category = "Transferencia"
        });

        // Limpiar formulario después de 2 segundos
        Task.Delay(2000).ContinueWith(_ =>
        {
            transferRecipient = "";
            transferAmount = 0;
            transferConcept = "";
            transferMessage = "";
            mostrarTransferDialog = false;
            InvokeAsync(StateHasChanged);
        });
    }

    private class Transaction
    {
        public string Icon { get; set; } = "";
        public string Description { get; set; } = "";
        public decimal Amount { get; set; }
        public DateTime Date { get; set; }
        public string Category { get; set; } = "";
    }
}
