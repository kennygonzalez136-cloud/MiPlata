@page "/login"
@rendermode InteractiveServer
@using MiPlata.Models
@inject CajeroService cajeroService

<div class="container">

    <div class="login-card">

        <h2 class="title">💳 YouthBank</h2>
        <p class="subtitle">Iniciar Sesión</p>

        <!-- Inputs -->
        <div class="input-group">
            <label>Usuario</label>
            <input placeholder="Usuario" @bind="username" />
        </div>

        <div class="input-group">
            <label>Contraseña</label>
            <input type="password" placeholder="••••••••" @bind="password" />
        </div>

        <!-- Botón -->
        <button class="btn" @onclick="Ingresar">Ingresar</button>

        <!-- Mensaje -->
        @if (!string.IsNullOrEmpty(mensaje))
        {
            <p class="message">@mensaje</p>
        }

        <p class="intentos">Intentos restantes: @intentos</p>

        <!-- Selección de cuenta -->
        @if (mostrarSeleccionCuenta)
        {
            <div class="cuenta-box">
                <h4>Selecciona el tipo de cuenta</h4>

                <button class="btn-sec" @onclick='() => CrearCuenta("Ahorros")'>
                    Ahorros
                </button>

                <button class="btn-sec" @onclick='() => CrearCuenta("Corriente")'>
                    Corriente
                </button>
            </div>
        }

    </div>
</div>

@code {
    private string username = "";
    private string password = "";
    private string mensaje = "";
    private int intentos = 3;

    private Usuario? usuarioLogeado;
    private bool mostrarSeleccionCuenta = false;

    private void Ingresar()
    {
        mensaje = "";
        mostrarSeleccionCuenta = false;

        var user = cajeroService.Login(username, password, out mensaje, out intentos);

        if (user == null)
            return;

        usuarioLogeado = user;

        bool tieneCuenta = cajeroService.TieneCuentas(user.Id);

        if (!tieneCuenta)
        {
            mostrarSeleccionCuenta = true;
            mensaje = "Debes crear una cuenta";
        }
        else
        {
            mensaje = $"Bienvenido {user.Username}";
        }
    }

    private void CrearCuenta(string tipo)
    {
        if (usuarioLogeado == null)
            return;

        string resultado = cajeroService.CrearCuenta(usuarioLogeado.Id, tipo);

        mensaje = resultado;
        mostrarSeleccionCuenta = false;
    }
}