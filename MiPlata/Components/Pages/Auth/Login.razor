@page "/login"
@rendermode InteractiveServer
@using MiPlata.Models
@inject CajeroService cajeroService
@inject NavigationManager Navigation
@inject MiPlata.Services.AppState AppState

<HeadContent>
    <link href="/css/login.css" rel="stylesheet" />
</HeadContent>

<div class="page-login-container">
    <div class="card-login">
        <h2 class="brand">💳 YouthBank</h2>
        <p class="lead">Iniciar sesión</p>

        <label class="label">Usuario</label>
        <input class="input" placeholder="Usuario" @bind="username" />

        <label class="label">Contraseña</label>
        <input class="input" type="password" placeholder="••••••••" @bind="password" />

        <button type="button" class="btn-primary" @onclick="Ingresar">Iniciar sesión</button>

        @if (!string.IsNullOrEmpty(mensaje))
        {
            <p class="alert">@mensaje</p>
        }

        <p class="info">Intentos restantes: <strong>@intentos</strong></p>

        @if (mostrarSeleccionCuenta)
        {
            <div class="account-select">
                <h4>Selecciona tipo de cuenta</h4>
                <div class="account-actions">
                    <button class="btn-outline" @onclick='() => CrearCuenta("Ahorros")'>Ahorros</button>
                    <button class="btn-outline" @onclick='() => CrearCuenta("Corriente")'>Corriente</button>
                </div>
            </div>
        }

        <div class="switch-area">
            <span>¿No tienes cuenta?</span>
            <button class="link-button" @onclick="IrRegister">Crear cuenta</button>
        </div>
    </div>
</div>

@code {
    private string username = "";
    private string password = "";
    private string mensaje = "";
    private int intentos = 3;

    private Usuario? usuarioLogeado;
    private bool mostrarSeleccionCuenta = false;

    private async Task Ingresar()
    {
        mensaje = "";
        mostrarSeleccionCuenta = false;

        var user = cajeroService.Login(username, password, out mensaje, out intentos);

        if (user == null)
            return;

        usuarioLogeado = user;
        // persist user in app state for the circuit (synchronous)
        AppState.SetUser(user);

        // show welcome message and let state propagate
        mensaje = $"Bienvenido {user.Username}";
        StateHasChanged();

        // small delay to ensure UI updates, then navigate
        await Task.Delay(250);
        Navigation.NavigateTo("/dashboard");
    }

    private void CrearCuenta(string tipo)
    {
        if (usuarioLogeado == null)
            return;

        string resultado = cajeroService.CrearCuenta(usuarioLogeado.Id, tipo);

        mensaje = resultado;
        mostrarSeleccionCuenta = false;
    }

    void IrRegister()
    {
        Navigation.NavigateTo("/register");
    }
}