@page "/"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<HeadContent>
    <link href="/css/index.css" rel="stylesheet" />
</HeadContent>

<div class="page-home">

<div class="min-h-screen">
    <NavbarComponent Variant="NavbarVariant.Home" />
    
    <!-- Hero Section -->
    <section class="hero-section">
        <div class="hero-bg"></div>

        <!-- Blobs animados -->
        <div class="blob blob-left"></div>
        <div class="blob blob-right"></div>

        <div class="hero-container">
            <div class="hero-grid">
                <div class="hero-copy">
                    <div class="hero-badge">✨ Banca Digital para Jóvenes</div>

                    <h1 class="hero-title">Tu Banco, Tu Estilo</h1>

                    <p class="hero-subtitle">Maneja tu dinero de forma fácil, rápida y divertida. YouthBank es el banco especialmente para ti. 🚀</p>

                    <div class="hero-actions">
                        <button class="btn-primary" type="button"  @onclick="IrLogin">Iniciar sesión</button>
                        <button class="btn-secondary" type="button" @onclick="IrRegister">Crear cuenta</button>
                    </div>
                </div>

                <div class="hero-media">
                    <img src="/images/hero-banking.jpg" alt="Joven usando banca digital" class="hero-image" />
                </div>
            </div>
        </div>
    </section>
    
    <!-- Features Section -->
    <section class="py-16 md:py-24 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <h2 class="text-3xl md:text-5xl font-bold mb-4">
                    <span class="bg-gradient-to-r from-purple-600 to-pink-600 bg-clip-text text-transparent">
                        ¿Por qué YouthBank?
                    </span>
                </h2>
            </div>
            
            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">

            </div>
        </div>
    </section>
    </div>
</div>

@code {

    void IrLogin()
    {
        Navigation.NavigateTo("/login");
    }
    void IrRegister()
    {
        Navigation.NavigateTo("/register");
    }
}