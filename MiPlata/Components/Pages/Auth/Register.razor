@page "/register"
@inject CajeroService cajeroService
@inject NavigationManager Navigation
@rendermode InteractiveServer
@using MiPlata.Models

<HeadContent>
    <link href="/css/register.css" rel="stylesheet" />
</HeadContent>

<div class="page-register">
    <div class="card-register">
        <h2 class="brand">📝 Crear cuenta</h2>

        <div class="grid-form">
            <input class="input" placeholder="Identificación" @bind="user.Identificacion" />
            <input class="input" placeholder="Nombre Completo" @bind="user.NombreCompleto" />
            <input class="input" placeholder="Celular" @bind="user.Celular" />
            <input class="input" placeholder="Usuario" @bind="user.Username" />
            <input class="input" type="password" placeholder="Contraseña" @bind="user.Password" />
            <input class="input" type="password" placeholder="Confirmar" @bind="confirm" />
        </div>

        <div class="actions">
            <button class="btn-primary" @onclick="Registrar">Registrar</button>
            <button class="link-button" @onclick="IrLogin">¿Ya tienes cuenta? Iniciar sesión</button>
        </div>

        @if (!string.IsNullOrEmpty(mensaje))
        {
            <p class="alert">@mensaje</p>
        }
    </div>
</div>

@code {
    Usuario user = new Usuario();
    string confirm = string.Empty;
    string mensaje = string.Empty;

    void Registrar()
    {
        if (user.Password != confirm)
        {
            mensaje = "Las contraseñas no coinciden";
            return;
        }

        mensaje = cajeroService.Registrar(user);
    }

    void IrLogin()
    {
        Navigation.NavigateTo("/login");
    }
}
